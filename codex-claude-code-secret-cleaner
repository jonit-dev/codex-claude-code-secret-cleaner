#!/usr/bin/env python3
from __future__ import annotations

import argparse
import fcntl
import os
import re
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path


MASK = "*******************"
STATE_DIR = Path.home() / ".local" / "state" / "codex-claude-code-secret-cleaner"
LOG_FILE = STATE_DIR / "scrubber.log"
LOCK_FILE = STATE_DIR / "scrubber.lock"


def build_patterns() -> list[tuple[str, re.Pattern[str], str]]:
    placeholder_prefixes = r"your|change|changeme|example|dummy|placeholder|redacted|masked"
    key_names = (
        r"api[_-]?key|access[_-]?token|auth[_-]?token|bearer[_-]?token|"
        r"refresh[_-]?token|client[_-]?secret|secret[_-]?key|private[_-]?key|"
        r"password|passwd|pwd|db[_-]?url|database[_-]?url|redis[_-]?url|"
        r"mongo(?:db)?[_-]?uri|connection[_-]?string"
    )

    return [
        (
            "private-key-block",
            re.compile(
                r"-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----.*?-----END [A-Z0-9 ]*PRIVATE KEY-----",
                re.DOTALL,
            ),
            MASK,
        ),
        ("aws-access-key-id", re.compile(r"\b(?:AKIA|ASIA)[0-9A-Z]{16}\b"), MASK),
        (
            "github-token",
            re.compile(r"\b(?:gh[pousr]_[A-Za-z0-9_]{36,}|github_pat_[A-Za-z0-9_]{20,})\b"),
            MASK,
        ),
        ("openai-token", re.compile(r"\bsk-(?:proj-|live_|test_)?[A-Za-z0-9_-]{20,}\b"), MASK),
        ("slack-token", re.compile(r"\bxox[baprs]-[A-Za-z0-9-]{10,}\b"), MASK),
        ("google-api-key", re.compile(r"\bAIza[0-9A-Za-z_-]{35}\b"), MASK),
        ("jwt", re.compile(r"\beyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\b"), MASK),
        (
            "basic-auth-url",
            re.compile(
                r"\b((?:mongodb(?:\+srv)?|postgres(?:ql)?|mysql|redis)://[^:\s/@]+:)"
                r"([A-Za-z0-9_./+=:%~-]+)"
                r"(@)",
                re.IGNORECASE,
            ),
            rf"\1{MASK}\3",
        ),
        (
            "key-value-secret",
            re.compile(
                rf"(?P<prefix>(?:{key_names})\s*[:=]\s*)(?P<quote>[\"'`]?)"
                rf"(?P<value>(?!(?:{placeholder_prefixes})[A-Za-z0-9_.-]*\b)[A-Za-z0-9_./+=:@%~-]{{16,}})(?P=quote)",
                re.IGNORECASE,
            ),
            rf"\g<prefix>\g<quote>{MASK}\g<quote>",
        ),
        (
            "json-key-value-secret",
            re.compile(
                rf"(?P<prefix>\"(?:{key_names})\"\s*:\s*)(?P<quote>[\"'])"
                rf"(?P<value>(?!(?:{placeholder_prefixes})[A-Za-z0-9_.-]*\b)[A-Za-z0-9_./+=:@%~-]{{16,}})(?P=quote)",
                re.IGNORECASE,
            ),
            rf"\g<prefix>\g<quote>{MASK}\g<quote>",
        ),
        (
            "authorization-header",
            re.compile(
                r"(?P<prefix>\bAuthorization\s*[:=]\s*(?:Bearer|Basic)\s+)(?P<value>[A-Za-z0-9_./+=:-]{16,})",
                re.IGNORECASE,
            ),
            rf"\g<prefix>{MASK}",
        ),
    ]


def secret_prefilter_regex() -> str:
    key_names = (
        r"api[_-]?key|access[_-]?token|auth[_-]?token|bearer[_-]?token|"
        r"refresh[_-]?token|client[_-]?secret|secret[_-]?key|private[_-]?key|"
        r"password|passwd|pwd|db[_-]?url|database[_-]?url|redis[_-]?url|"
        r"mongo(?:db)?[_-]?uri|connection[_-]?string"
    )
    return (
        r"(?:AKIA|ASIA)[0-9A-Z]{16}|"
        r"gh[pousr]_[A-Za-z0-9_]{36,}|github_pat_[A-Za-z0-9_]{20,}|"
        r"sk-(?:proj-|live_|test_)?[A-Za-z0-9_-]{20,}|"
        r"xox[baprs]-[A-Za-z0-9-]{10,}|"
        r"AIza[0-9A-Za-z_-]{35}|"
        r"eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}|"
        r"-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----|"
        r"(?:mongodb(?:\+srv)?|postgres(?:ql)?|mysql|redis)://[^:\s/@]+:[A-Za-z0-9_./+=:%~-]+@|"
        rf"(?:{key_names})\s*[:=]\s*[\"'`]?[A-Za-z0-9_./+=:@%~-]{{16,}}|"
        rf"\"(?:{key_names})\"\s*:\s*[\"'][^\"'\s]{{16,}}[\"']|"
        r"authorization\s*[:=]\s*(?:bearer|basic)\s+[A-Za-z0-9_./+=:-]{16,}"
    )


def default_paths() -> list[Path]:
    home = Path.home()
    return [
        home / ".codex" / "sessions",
        home / ".codex" / "shell_snapshots",
        home / ".codex" / "history.jsonl",
        home / ".codex" / "log" / "codex-tui.log",
        home / ".claude" / "sessions",
        home / ".claude" / "projects",
        home / ".claude" / "history.jsonl",
    ]


def candidate_files(paths: list[Path]) -> list[Path]:
    existing = [path for path in paths if path.exists()]
    if not existing:
        return []

    search_paths = [str(path) for path in existing]
    try:
        result = subprocess.run(
            [
                "rg",
                "--files-with-matches",
                "--null",
                "--hidden",
                "--no-ignore",
                "--ignore-case",
                "--regexp",
                secret_prefilter_regex(),
                *search_paths,
            ],
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
        )
        if result.returncode in (0, 1):
            return sorted(
                {
                    Path(item.decode("utf-8", errors="surrogateescape"))
                    for item in result.stdout.split(b"\0")
                    if item
                }
            )
    except FileNotFoundError:
        pass

    candidates: list[Path] = []
    for path in existing:
        if path.is_file():
            candidates.append(path)
        elif path.is_dir():
            candidates.extend(child for child in path.rglob("*") if child.is_file())
    return sorted(set(candidates))


def redact_text(text: str, patterns: list[tuple[str, re.Pattern[str], str]]) -> tuple[str, int]:
    total = 0
    redacted = text
    for _name, pattern, replacement in patterns:
        redacted, count = pattern.subn(replacement, redacted)
        total += count
    return redacted, total


def line_may_contain_secret(line: str) -> bool:
    lowered = line.lower()
    if any(
        marker in line
        for marker in (
            "AKIA",
            "ASIA",
            "ghp_",
            "gho_",
            "ghu_",
            "ghs_",
            "ghr_",
            "github_pat_",
            "sk-",
            "xox",
            "AIza",
            "eyJ",
            "-----BEGIN ",
        )
    ):
        return True
    return any(
        marker in lowered
        for marker in (
            "api_key",
            "api-key",
            "access_token",
            "access-token",
            "auth_token",
            "auth-token",
            "bearer_token",
            "bearer-token",
            "refresh_token",
            "refresh-token",
            "client_secret",
            "client-secret",
            "secret_key",
            "secret-key",
            "private_key",
            "private-key",
            "password",
            "passwd",
            "pwd",
            "authorization",
            "database_url",
            "database-url",
            "db_url",
            "db-url",
            "redis_url",
            "redis-url",
            "mongodb://",
            "mongodb+srv://",
            "postgres://",
            "postgresql://",
            "mysql://",
            "redis://",
            "connection_string",
            "connection-string",
        )
    )


def count_file_redactions(path: Path, patterns: list[tuple[str, re.Pattern[str], str]]) -> int:
    count = 0
    in_private_key = False
    try:
        with path.open("rb") as fh:
            for raw_line in fh:
                line = raw_line.decode("utf-8", errors="surrogateescape")
                if in_private_key:
                    count += 1
                    if "-----END " in line and "PRIVATE KEY-----" in line:
                        in_private_key = False
                    continue
                if "-----BEGIN " in line and "PRIVATE KEY-----" in line and "-----END " not in line:
                    count += 1
                    in_private_key = True
                    continue
                if not line_may_contain_secret(line):
                    continue
                _redacted, line_count = redact_text(line, patterns)
                count += line_count
    except OSError:
        return 0
    return count


def redact_file_to_temp(path: Path, patterns: list[tuple[str, re.Pattern[str], str]], tmp: Path) -> int:
    count = 0
    in_private_key = False
    with path.open("rb") as src, tmp.open("wb") as dst:
        for raw_line in src:
            line = raw_line.decode("utf-8", errors="surrogateescape")
            if in_private_key:
                count += 1
                if "-----END " in line and "PRIVATE KEY-----" in line:
                    in_private_key = False
                dst.write((MASK + "\n").encode("utf-8"))
                continue
            if "-----BEGIN " in line and "PRIVATE KEY-----" in line and "-----END " not in line:
                count += 1
                in_private_key = True
                dst.write((MASK + "\n").encode("utf-8"))
                continue
            if not line_may_contain_secret(line):
                dst.write(raw_line)
                continue
            redacted, line_count = redact_text(line, patterns)
            count += line_count
            dst.write(redacted.encode("utf-8", errors="surrogateescape"))
    return count


def redact_file(path: Path, patterns: list[tuple[str, re.Pattern[str], str]], dry_run: bool) -> int:
    count = count_file_redactions(path, patterns)
    if count == 0 or dry_run:
        return count

    tmp = path.with_name(f".{path.name}.scrubtmp")
    stat = path.stat()
    try:
        redact_file_to_temp(path, patterns, tmp)
        os.chmod(tmp, stat.st_mode & 0o777)
        os.replace(tmp, path)
    finally:
        if tmp.exists():
            tmp.unlink()
    return count


def log(message: str) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    timestamp = datetime.now(timezone.utc).isoformat(timespec="seconds")
    with LOG_FILE.open("a", encoding="utf-8") as fh:
        fh.write(f"{timestamp} {message}\n")


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Redact secrets from local Codex and Claude Code conversation history."
    )
    parser.add_argument("--dry-run", action="store_true", help="Report counts without modifying files.")
    parser.add_argument("--quiet", action="store_true", help="Only write the audit log.")
    parser.add_argument(
        "--path",
        action="append",
        type=Path,
        help="File or directory to scan. Can be passed multiple times. Defaults to Codex and Claude Code history paths.",
    )
    args = parser.parse_args()

    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with LOCK_FILE.open("w", encoding="utf-8") as lock_fh:
        try:
            fcntl.flock(lock_fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            log("skipped already_running=1")
            return 0

        patterns = build_patterns()
        changed_files = 0
        redactions = 0
        scanned = 0
        paths = args.path if args.path else default_paths()

        for path in candidate_files(paths):
            scanned += 1
            count = redact_file(path, patterns, args.dry_run)
            if count:
                changed_files += 1
                redactions += count

        mode = "dry_run" if args.dry_run else "redact"
        summary = f"mode={mode} scanned_files={scanned} changed_files={changed_files} redactions={redactions}"
        log(summary)
        if not args.quiet:
            print(summary)

    return 0


if __name__ == "__main__":
    sys.exit(main())

